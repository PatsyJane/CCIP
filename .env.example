# Env_Config for the Cloud Cost Intelligence Pipeline (PoC).
# Copy this file to `.env` and fill in the values. The Connector loads these
# via python-dotenv at startup and aborts if any REQUIRED value is missing,
# empty, or whitespace-only.

# ===========================================================================
# Cloud Billing & Telemetry Connector (spec: billing-usage-ingestion)
# ===========================================================================

# --- Required: target AWS account (Req 12.1) ---
# The account identifier is used to populate the `account` Dimension_Tag.
AWS_ACCOUNT_ID=
AWS_ACCOUNT_NAME=
AWS_REGION=

# --- Required: Cost_API connection (Req 12.2) ---
# Base URL of the external Cost_API. The tool issues POST {COST_API_BASE_URL}/api/costs.
# PoC example: http://40.81.230.124:8001
COST_API_BASE_URL=
# Sent in the Cost_API request body.
PROVIDER=
PROJECT=

# --- Optional: AWS credentials (Req 12.3) ---
# Only required WHERE credentials are needed to reach the Cost_API.
# Never logged or returned in tool output (Req 12.6, 12.7).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===========================================================================
# CCIP LangGraph Anomaly Detection Workflow (spec: ccip-langgraph-anomaly)
# Injected into config.yaml via ${VAR} placeholders. Consumed by
# scripts/run_ccip_check.py. See config.yaml for the full contract.
# ===========================================================================

# --- Required: LLM (Gemini Developer API key) ---
CCIP_LLM_API_KEY=
# Optional override; defaults to gemini-2.5-flash-lite in config.yaml.
CCIP_LLM_MODEL=gemini-2.5-flash-lite

# --- Email alert (SMTP). Leave host/username/password blank for a safe dry run. ---
CCIP_EMAIL_FROM=
CCIP_EMAIL_TO=testuser@ilios.digital
CCIP_SMTP_HOST=smtp.gmail.com
CCIP_SMTP_PORT=587
CCIP_SMTP_USERNAME=
# Gmail App Password (requires 2FA); NOT your normal account password.
CCIP_SMTP_PASSWORD=

# --- Optional: detection + STL tuning (defaults shown in config.yaml) ---
# Cold Start (<30 days) absolute $ threshold vs the previous non-anomaly day.
CCIP_COLD_START_ABS_THRESHOLD=20.0
# Statistical method for Initial/Beginner/Normal modes: "iqr" or "sigma".
CCIP_STAT_METHOD=iqr
CCIP_IQR_FACTOR=1.5
CCIP_SIGMA_FACTOR=3.0
# STL seasonality (weekly default for daily cost data).
CCIP_STL_PERIOD=7
CCIP_STL_SEASONAL=7
CCIP_STL_ROBUST=true
# Single-fetch history window (days) ending at the Target_Date.
CCIP_HISTORY_DAYS=90

# --- Optional: persistent metadata store path (single JSON file) ---
CCIP_METADATA_PATH=ccip_metadata.json
