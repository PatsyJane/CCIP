# Env_Config for the Cloud Cost Intelligence Pipeline (PoC).
# Copy this file to `.env` and fill in the values. The Connector loads these
# via python-dotenv at startup and aborts if any REQUIRED value is missing,
# empty, or whitespace-only.

# ===========================================================================
# Cloud Billing & Telemetry Connector (spec: billing-usage-ingestion)
# ===========================================================================

# --- Required: target AWS account (Req 12.1) ---
# The account identifier is used to populate the `account` Dimension_Tag.
AWS_ACCOUNT_ID=
AWS_ACCOUNT_NAME=
AWS_REGION=

# --- Required: Cost_API connection (Req 12.2) ---
# Base URL of the external Cost_API. The tool issues POST {COST_API_BASE_URL}/api/costs.
# PoC example: http://40.81.230.124:8001
COST_API_BASE_URL=
# Sent in the Cost_API request body.
PROVIDER=
PROJECT=

# --- Optional: AWS credentials (Req 12.3) ---
# Only required WHERE credentials are needed to reach the Cost_API.
# Never logged or returned in tool output (Req 12.6, 12.7).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional: structured logging ---
# Verbosity of the structured JSON logger shared by the Connector and the CCIP
# workflow. One of DEBUG / INFO / WARNING / ERROR / CRITICAL. Defaults to INFO
# when unset or blank. Secrets are always scrubbed from logs regardless of level.
LOG_LEVEL=INFO

# ===========================================================================
# CCIP LangGraph Anomaly Detection Workflow (spec: ccip-langgraph-anomaly)
# Injected into config.yaml via ${VAR} placeholders. Consumed by
# scripts/run_ccip_check.py. See config.yaml for the full contract.
# ===========================================================================

# --- Required: LLM (Gemini Developer API key) ---
CCIP_LLM_API_KEY=
# Optional override; defaults to gemini-2.5-flash-lite in config.yaml.
CCIP_LLM_MODEL=gemini-2.5-flash-lite

# --- Email alert (SMTP). Leave host/username/password blank for a safe dry run. ---
CCIP_EMAIL_FROM=
CCIP_EMAIL_TO=testuser@ilios.digital
# Separate operations recipient for terminal failure-notification alerts
# (Req 12.8). Leave blank to dry-run the failure alert (log only, no send).
CCIP_ALERT_FAILURE_TO=
CCIP_SMTP_HOST=smtp.gmail.com
CCIP_SMTP_PORT=587
CCIP_SMTP_USERNAME=
# Gmail App Password (requires 2FA); NOT your normal account password.
CCIP_SMTP_PASSWORD=

# --- Fetch retry: transient Cost_API failures only (Req 12.1-12.3). Defaults shown. ---
# Bounded exponential backoff with jitter; retries ONLY unreachable-source fetch
# failures. Deterministic errors are never retried.
CCIP_RETRY_MAX_ATTEMPTS=3
CCIP_RETRY_BASE_DELAY=1.0
CCIP_RETRY_MAX_DELAY=30.0
CCIP_RETRY_MULTIPLIER=2.0
CCIP_RETRY_JITTER=true

# --- Optional: detection + STL tuning (defaults shown in config.yaml) ---
# Cold Start (<30 days) absolute $ threshold vs the previous non-anomaly day.
CCIP_COLD_START_ABS_THRESHOLD=20.0
# Statistical method for Initial/Beginner/Normal modes: "iqr" or "sigma".
CCIP_STAT_METHOD=iqr
CCIP_IQR_FACTOR=1.5
CCIP_SIGMA_FACTOR=3.0
# STL seasonality (weekly default for daily cost data).
CCIP_STL_PERIOD=7
CCIP_STL_SEASONAL=7
CCIP_STL_ROBUST=true
# Rolling_History_Window length (days) + FULL-pull span, ending at the Target_Date.
CCIP_HISTORY_DAYS=90

# --- Optional: incremental ingestion + D-2 offset (increment 2; defaults shown) ---
# Default Target_Date offset: a run with no explicit date evaluates D-N. 2 (D-2)
# skips the still-settling "yesterday" of AWS CUR data.
CCIP_TARGET_DATE_OFFSET_DAYS=2
# Steady-state trailing window merged into the persisted history (2 => D and D-1).
CCIP_TRAILING_FETCH_DAYS=2
# Cadence (days) of the periodic FULL reconciliation pull that self-heals drift.
CCIP_RECONCILIATION_INTERVAL_DAYS=7

# --- Optional: persistent metadata store (increment 2 partitions per account) ---
# Legacy single-file path (retained for backward compatibility).
CCIP_METADATA_PATH=ccip_metadata.json
# Base directory for per-account files: <dir>/ccip_metadata_<name>_<id>.json.
CCIP_METADATA_DIR=metadata
